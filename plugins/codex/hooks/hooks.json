{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LARES_HARNESS_PID=$PPID ~/.lares/bin/lares-forwarder",
            "commandWindows": "& \"$env:USERPROFILE\\.lares\\bin\\lares-forwarder.cmd\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LARES_HARNESS_PID=$PPID ~/.lares/bin/lares-forwarder",
            "commandWindows": "& \"$env:USERPROFILE\\.lares\\bin\\lares-forwarder.cmd\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LARES_HARNESS_PID=$PPID ~/.lares/bin/lares-forwarder",
            "commandWindows": "& \"$env:USERPROFILE\\.lares\\bin\\lares-forwarder.cmd\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LARES_HARNESS_PID=$PPID ~/.lares/bin/lares-forwarder",
            "commandWindows": "& \"$env:USERPROFILE\\.lares\\bin\\lares-forwarder.cmd\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LARES_HARNESS_PID=$PPID ~/.lares/bin/lares-forwarder",
            "commandWindows": "& \"$env:USERPROFILE\\.lares\\bin\\lares-forwarder.cmd\""
          }
        ]
      }
    ]
  }
}
