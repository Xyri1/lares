{
  "name": "lares-app",
  "version": "1.0.0",
  "description": "A minimal Electron application with TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "adapter:remove": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/remove-adapters.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-character.mjs",
    "smoke:nerves": "node scripts/synthetic-session.mjs",
    "build": "pnpm run typecheck && electron-vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@pixi/unsafe-eval": "6.5.10",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "electron": "^39.2.6",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
